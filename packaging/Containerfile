# bread-tracker-server, single image.
# Build:  docker build -t bread-tracker:local -f packaging/Containerfile .

FROM docker.io/library/rust:1-bookworm AS build
WORKDIR /s
COPY Cargo.toml Cargo.lock ./
COPY server server
COPY migrations migrations
COPY spec spec
RUN cargo build --release --locked -p bread-tracker-server

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates sqlite3 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 tracker && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent tracker
COPY --from=build /s/target/release/bread-tracker-server /usr/local/bin/bread-tracker-server
RUN mkdir -p /var/lib/bread-tracker && chown -R 10001:10001 /var/lib/bread-tracker
RUN printf '#!/bin/sh\nset -eu\nexec "$@"\n' > /usr/local/bin/entrypoint-exec && chmod 755 /usr/local/bin/entrypoint-exec
USER 10001:10001
ENV BREADTRACKER_LISTEN=0.0.0.0:7290 \
    BREADTRACKER_DATABASE_PATH=/var/lib/bread-tracker/bread-tracker.db
VOLUME /var/lib/bread-tracker
EXPOSE 7290
ENTRYPOINT ["/usr/local/bin/entrypoint-exec", "/usr/local/bin/bread-tracker-server"]
CMD []
